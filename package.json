{
    "name": "whisperqueue",
    "version": "0.1.0",
    "description": "Official TypeScript SDK for WhisperQueue — async GPU transcription microservice",
    "keywords": [
        "transcription",
        "whisper",
        "faster-whisper",
        "whisperqueue",
        "sdk",
        "typescript",
        "audio"
    ],
    "homepage": "https://github.com/WhisperQueue/whisperqueue-ts#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/WhisperQueue/whisperqueue-ts.git"
    },
    "bugs": {
        "url": "https://github.com/WhisperQueue/whisperqueue-ts/issues"
    },
    "license": "MIT",
    "author": "WhisperQueue Contributors",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18.0.0",
        "bun": ">=1.2.0"
    },
    "scripts": {
        "prepare": "lefthook install",
        "build": "tsup",
        "dev": "tsup --watch",
        "check:types": "tsc --noEmit",
        "check:code": "fallow",
        "check:dupes": "fallow dupes",
        "check:health": "fallow health",
        "check:dead-code": "fallow dead-code",
        "check": "bun run check:types && bun run check:code",
        "lint": "biome check .",
        "lint:fix": "biome check --fix .",
        "test": "bun test"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@commitlint/cli": "^21.0.1",
        "@commitlint/config-conventional": "^21.0.1",
        "@types/bun": "^1.3.14",
        "fallow": "^2.75.0",
        "lefthook": "^2.1.6",
        "tsup": "^8.5.0",
        "typescript": "^6.0.3"
    }
}
